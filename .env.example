# Copy to .env and adjust. Never commit .env.
IDX_DATABASE_URL=postgresql+psycopg://idx:idx@localhost:5432/idx_trading
IDX_DATA_DIR=./data
IDX_SOURCES_FILE=./config/sources.yaml
IDX_LOG_LEVEL=INFO
IDX_LOG_JSON=false
# Minutes after the official close before EOD data is considered final.
IDX_EOD_READY_BUFFER_MINUTES=90
# Daily change (fraction) above which a price move is flagged for review.
IDX_EXTREME_MOVE_THRESHOLD=0.35
# Test database (optional). When unset, PostgreSQL tests are skipped.
# IDX_TEST_DATABASE_URL=postgresql+psycopg://idx:idx@localhost:5432/idx_trading_test
# EODHD (ADR 0008). Secret: put it in .env (never committed) or a CI secret.
# IDX_EODHD_API_TOKEN=
# Free plan = 20 calls/day and 1 year of history; raise both on a paid plan.
IDX_EODHD_DAILY_CALL_BUDGET=20
IDX_EODHD_HISTORY_DAYS=365
